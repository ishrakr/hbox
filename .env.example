# HBOX configuration. The installer copies this to .env (mode 600) and fills in
# passwords; edit .env, then run: sudo hbox restart. See wiki/Configuration.md.
HBOX_HOME=/opt/hbox
DATA_ROOT=/DATA
TZ=Etc/UTC
PUID=1000
PGID=1000

# Generated by the installer for new installs. For a migration they MUST match
# the passwords of the existing databases (the old defaults were immich and
# nextcloud). Changing them here does not change an initialized database.
IMMICH_DB_PASSWORD=replace-with-generated-password
NEXTCLOUD_DB_PASSWORD=replace-with-generated-password

# Where the host writes disk/backup/update status for the dashboard.
HBOX_STATUS_DIR=/var/lib/hbox/dashboard

# Updates from git (sudo hbox update; wiki/Updates.md). HBOX_REF is a branch
# (main), a release tag (v1.2.0), or "stable" for the newest release tag.
HBOX_REPO=https://github.com/ishrakr/hbox.git
HBOX_REF=main
# 1: install updates automatically after the nightly check (backup first).
HBOX_AUTO_UPDATE=0

# Optional apps that are enabled (sudo hbox apps enable NAME), comma separated.
HBOX_APPS=

# App versions come from HBOX's compose files and change with hbox update.
# Uncomment only to hold an app at a version of your own choosing:
# IMMICH_VERSION=v3.4.1
# NEXTCLOUD_IMAGE=lscr.io/linuxserver/nextcloud:35.0.3
# DOCKGE_IMAGE=louislam/dockge:1.5.0
# TAILSCALE_IMAGE=tailscale/tailscale:v1.104.7

# Direct app ports are loopback-only; nginx serves the LAN over HTTPS.
APP_BIND_ADDRESS=127.0.0.1

# Announce hbox.local, photos.local, files.local and admin.local on the LAN.
HBOX_MDNS=1
# Extra names/IPs HBOX is reached by (router DNS name, host-level Tailscale),
# comma separated. LAN IP and HBOX's own Tailscale are detected automatically.
HBOX_EXTRA_NAMES=

# Optional Tailscale remote access: sudo hbox enable tailscale
HBOX_ENABLE_TAILSCALE=0
TS_AUTHKEY=
TS_ROUTES=
TS_HOSTNAME=hbox
