#!/usr/bin/env bash
# hbox: install, run, update, back up and restore an HBOX home server.
set -Eeuo pipefail

# shellcheck source=lib/common.sh
. "$(dirname -- "$(readlink -f -- "$0")")/lib/common.sh"
# shellcheck source=lib/backup.sh
. "$HBOX_LIB_DIR/backup.sh"
# shellcheck source=lib/backrest.sh
. "$HBOX_LIB_DIR/backrest.sh"
# shellcheck source=lib/disk.sh
. "$HBOX_LIB_DIR/disk.sh"
# shellcheck source=lib/apps.sh
. "$HBOX_LIB_DIR/apps.sh"
# shellcheck source=lib/update.sh
. "$HBOX_LIB_DIR/update.sh"
# shellcheck source=lib/dashboard.sh
. "$HBOX_LIB_DIR/dashboard.sh"

HBOX_CREDENTIALS=$HBOX_ETC/credentials
HBOX_CA_DIR=${HBOX_CA_DIR:-$HBOX_ETC/ca}
export HBOX_CA_DIR

usage() {
    cat <<'EOF'
Usage: sudo hbox <command> [options]

Everyday
  status                 Show apps, addresses, disk space and backup state
  start | stop | restart Start, stop or restart all HBOX apps
  logs [service]         Follow logs (all apps, or one service)
  credentials            Show the administrator login created at install
  doctor                 Check the installation for common problems

Updates and apps (from git)
  update                 Back up, then install the latest HBOX from git
  update --check         Show whether a newer HBOX exists, and what changed
  update --ref REF       Follow another branch or tag (e.g. v1.2.0, stable)
  rollback [VERSION]     Go back to the previous (or given) HBOX version
  version                Show the installed HBOX version
  apps list              Optional apps shipped with HBOX or in local/apps
  apps enable NAME       Install and start an optional app on its own port
  apps disable NAME      Stop it (its data is kept)

Backups (restic, managed in Backups/Backrest at https://<server>:6443)
  backup disk            Use an attached disk for backups (formats an empty one)
  backup disk list       Show attached disks and whether they can be used
  backup disk eject      Unmount the backup disk so it can be unplugged
  backup setup --repo R  Use a NAS, cloud bucket or other repository instead
  backup run             Back up now
  backup status          Show the last backup result and next scheduled run
  backup snapshots       List backups
  backup check           Verify the repository and part of the stored data
  backup restore [ID]    Restore everything from a backup (default: latest)
  backup password        Show the repository password (store it safely!)

Remote access and devices
  enable tailscale [--authkey KEY]   Turn on Tailscale remote access
  disable tailscale                  Turn it off again
  certs renew            Issue a new HTTPS certificate (devices keep trust)
  certs names            List the extra names/IPs the certificate covers
  ca                     Show how to trust HBOX's HTTPS on your devices

Installation
  setup [options]        Configure and start HBOX (run by the installer)
  uninstall              Remove HBOX services; keeps all data and backups

Run 'hbox setup --help' for installation options.
EOF
}

# ---------------------------------------------------------------- helpers

stack_up() {
    local stack=$1 broken
    shift
    log "Starting $stack"
    # A container stuck restarting (e.g. after fixing its directory) is
    # recreated instead of being waited on; no data lives in containers.
    broken=$(stack_compose "$stack" ps -a --status restarting --quiet 2>/dev/null || true)
    if [ -n "$broken" ]; then
        # shellcheck disable=SC2086
        docker rm -f $broken >/dev/null
    fi
    with_retries "Starting $stack" stack_up_attempt "$stack" "$@"
}

stack_up_attempt() {
    local stack=$1 unhealthy
    shift
    # "up" leaves a running container alone even when it is unhealthy, so a
    # retry would wait on the same stuck process; recreate those instead.
    unhealthy=$(stack_compose "$stack" ps --quiet --status running 2>/dev/null |
        xargs -r docker inspect -f '{{if .State.Health}}{{if eq .State.Health.Status "unhealthy"}}{{.Name}}{{end}}{{end}}' 2>/dev/null |
        sed 's#^/##; /^$/d' || true)
    if [ -n "$unhealthy" ]; then
        warn "Recreating unhealthy container(s): $unhealthy"
        # A clean stop first: this may be a database.
        # shellcheck disable=SC2086
        docker stop -t 120 $unhealthy >/dev/null 2>&1 || true
        # shellcheck disable=SC2086
        docker rm -f $unhealthy >/dev/null
    fi
    stack_compose "$stack" up -d --remove-orphans --wait --wait-timeout 300 "$@"
}

hbox_start_all() {
    ensure_network
    local stack
    while IFS= read -r stack; do
        stack_up "$stack"
    done < <(enabled_stacks)
    stack_up hbox-dockge
}

hbox_stop_all() {
    local stack
    stack_compose hbox-dockge stop || true
    for stack in hbox-tailscale hbox-files hbox-photos hbox-core; do
        stack_compose "$stack" stop || true
    done
}

wait_for_nextcloud() {
    local deadline=$((SECONDS + ${1:-300}))
    while [ "$SECONDS" -lt "$deadline" ]; do
        if container_running nextcloud &&
            docker exec nextcloud test -f /app/www/public/occ 2>/dev/null &&
            docker exec nextcloud sh -c 'pgrep -f php-fpm >/dev/null' 2>/dev/null &&
            nextcloud_settled &&
            docker exec nextcloud curl -fsk -o /dev/null -m 5 https://localhost/status.php 2>/dev/null; then
            return 0
        fi
        sleep 3
    done
    return 1
}

# Not upgrading: a newer image upgrades the instance on its first start, with
# maintenance mode on; settings changed meanwhile can be lost.
nextcloud_settled() {
    local status
    status=$(occ status --output=json 2>/dev/null) || return 1
    case $status in *'"installed":false'*) return 0 ;; esac
    [[ $status == *'"maintenance":false'* && $status == *'"needsDbUpgrade":false'* ]]
}

http_ok() {
    curl -fsS -o /dev/null -m 5 "$1"
}

# Run a command until it succeeds, for up to 60 seconds.
eventually() {
    local deadline=$((SECONDS + 60))
    until "$@" >/dev/null 2>&1; do
        [ "$SECONDS" -ge "$deadline" ] && return 1
        sleep 3
    done
}

generate_password() {
    # 20 alphanumeric characters, always containing both letters and digits
    # (Dockge rejects passwords without both).
    local pw
    while :; do
        pw=$(openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | cut -c1-20)
        [[ ${#pw} -eq 20 && $pw =~ [0-9] && $pw =~ [A-Za-z] ]] && break
    done
    printf '%s' "$pw"
}

link_stack_env() {
    # Dockge runs `docker compose` inside each stack directory, which reads
    # ./.env; point them all at the single HBOX configuration.
    local dir
    for dir in "$HBOX_HOME"/stacks/*/ "$HBOX_HOME/manager/"; do
        ln -sfn ../../.env "$dir/.env" 2>/dev/null || true
    done
    ln -sfn ../.env "$HBOX_HOME/manager/.env"
}

frontend_subnet() {
    docker network inspect "$HBOX_NETWORK" -f '{{range .IPAM.Config}}{{.Subnet}} {{end}}' | awk '{print $1}'
}

# Add VALUE to a Nextcloud array setting unless already present.
nextcloud_array_add() {
    local key=$1 value=$2 current index=0
    current=$(occ config:system:get "$key" 2>/dev/null || true)
    if printf '%s\n' "$current" | grep -Fxq -- "$value"; then
        return 0
    fi
    while occ config:system:get "$key" "$index" >/dev/null 2>&1; do
        index=$((index + 1))
    done
    occ config:system:set "$key" "$index" --value="$value" >/dev/null ||
        die "Could not add $value to Nextcloud's $key."
    occ config:system:get "$key" 2>/dev/null | grep -Fxq -- "$value" ||
        die "Nextcloud did not keep $value in $key (was it upgrading?). Re-run: sudo hbox update --skip-backup"
}

configure_nextcloud_proxy() {
    local subnet ip name
    subnet=$(frontend_subnet)
    ip=$(primary_ip || true)
    # Every name HBOX answers to: LAN names, the LAN IP, Tailscale names/IPs
    # (*.ts.net and 100.x). Files is served at the root of port 3443 and of
    # files.local, so Nextcloud needs no path settings.
    for name in files.local files hbox.local hbox "$(hostname -s).local" '*.ts.net' '100.*' \
        $(env_get_default HBOX_EXTRA_NAMES '' | tr ',' ' '); do
        nextcloud_array_add trusted_domains "$name"
    done
    [ -n "$ip" ] && nextcloud_array_add trusted_domains "$ip"
    [ -n "$subnet" ] && nextcloud_array_add trusted_proxies "$subnet"
    occ config:system:set overwriteprotocol --value=https >/dev/null
    occ config:system:set overwrite.cli.url --value=https://files.local >/dev/null
}

is_hbox_project() {
    case $1 in
        hbox-core | hbox-photos | hbox-files | hbox-dockge | hbox-tailscale | hbox-app-*) return 0 ;;
        *) return 1 ;;
    esac
}

# Containers from the previous hbox-apps deployment that would clash by name
# or port with the new stacks. Tailscale is reported separately, never removed.
conflicting_containers() {
    local name project image
    for name in hbox-nginx hbox-homepage homepage immich-server immich-machine-learning \
        immich_redis immich-postgres nextcloud nextcloud-db hbox-dockge dockge; do
        project=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$name" 2>/dev/null) || continue
        is_hbox_project "$project" || printf '%s\n' "$name"
    done
    # Dockge installed by its own instructions runs as e.g. dockge-dockge-1 and
    # holds port 5001.
    # "|" separates fields: read with a tab IFS would merge an empty label.
    while IFS='|' read -r name project image; do
        case $name in dockge) continue ;; esac
        case $image in louislam/dockge*) is_hbox_project "$project" || printf '%s\n' "$name" ;; esac
    done < <(docker ps -a --format '{{.Names}}|{{.Label "com.docker.compose.project"}}|{{.Image}}')
}

# Disable mDNS announcements of HBOX names made outside HBOX (for example
# avahi-alias@photos.local.service): two publishers of one name collide.
disable_foreign_mdns_aliases() {
    local unit
    while read -r unit _; do
        case $unit in
            avahi-alias@hbox.local.service | avahi-alias@photos.local.service | \
                avahi-alias@files.local.service | avahi-alias@admin.local.service)
                log "Replacing $unit with HBOX's own announcements"
                systemctl disable --now "$unit" >/dev/null 2>&1 || true
                ;;
        esac
    done < <(systemctl list-units --all --plain --no-legend 'avahi-alias@*' 2>/dev/null)
}

# A backup unit named hbox-backup that HBOX did not install (a hand-made
# restic script). It keeps running under another name until HBOX backups are
# set up, so a migration never leaves the server without nightly backups.
LEGACY_BACKUP_UNIT=hbox-legacy-backup

preserve_legacy_backup_units() {
    local service=$HBOX_SYSTEMD_DIR/hbox-backup.service timer=$HBOX_SYSTEMD_DIR/hbox-backup.timer enabled=0
    [ -f "$service" ] || return 0
    grep -q 'hbox backup run' "$service" && return 0
    log "Keeping the existing backup job as $LEGACY_BACKUP_UNIT until HBOX backups are set up"
    systemctl is-enabled --quiet hbox-backup.timer 2>/dev/null && enabled=1
    systemctl disable --now hbox-backup.timer >/dev/null 2>&1 || true
    install -d -m 700 "$HBOX_ETC/legacy"
    cp -p -- "$service" "$HBOX_ETC/legacy/hbox-backup.service"
    mv -f -- "$service" "$HBOX_SYSTEMD_DIR/$LEGACY_BACKUP_UNIT.service"
    if [ -f "$timer" ]; then
        cp -p -- "$timer" "$HBOX_ETC/legacy/hbox-backup.timer"
        mv -f -- "$timer" "$HBOX_SYSTEMD_DIR/$LEGACY_BACKUP_UNIT.timer"
    fi
    systemctl daemon-reload
    if [ "$enabled" = 1 ] && [ -f "$HBOX_SYSTEMD_DIR/$LEGACY_BACKUP_UNIT.timer" ]; then
        systemctl enable --now "$LEGACY_BACKUP_UNIT.timer" >/dev/null
    fi
}

# Print the hbox backup setup command matching the previous backup script.
legacy_backup_hint() {
    local unit=$HBOX_SYSTEMD_DIR/$LEGACY_BACKUP_UNIT.service script repo password_file
    [ -f "$unit" ] || return 0
    script=$(sed -n 's/^ExecStart=[-@+!]*\([^ ]*\).*/\1/p' "$unit" | head -n 1)
    if [ -f "$script" ]; then
        repo=$(grep -oE 'RESTIC_REPOSITORY=[^ ;"]+' "$script" | head -n 1 | cut -d= -f2-)
        password_file=$(grep -oE 'RESTIC_PASSWORD_FILE=[^ ;"]+' "$script" | head -n 1 | cut -d= -f2-)
    fi
    cat >&2 <<EOF

Your previous backup job keeps running nightly ($LEGACY_BACKUP_UNIT.timer).
Switch to HBOX backups, which also cover the databases, Admin and HBOX itself:
    sudo hbox backup setup --existing --repo ${repo:-<repository>} --password-file ${password_file:-<password file>}
This reuses the same repository and stops the previous job.
EOF
}

old_tailscale_containers() {
    local name project image
    while IFS='|' read -r name project image; do
        case $image in tailscale/tailscale* | docker.io/tailscale/tailscale* | ghcr.io/tailscale/tailscale*)
            is_hbox_project "$project" || printf '%s\n' "$name" ;;
        esac
    done < <(docker ps --format '{{.Names}}|{{.Label "com.docker.compose.project"}}|{{.Image}}')
}

# ---------------------------------------------------------------- setup

setup_usage() {
    cat <<'EOF'
Usage: sudo hbox setup [options]

  --data-root PATH        Where HBOX keeps data (default /DATA)
  --timezone TZ           e.g. Europe/London (default: this server's zone)
  --admin-user NAME       Administrator name for Files and Admin (default admin)
  --admin-email EMAIL     Administrator e-mail for Photos (default admin@hbox.local)
  --migrate               Adopt an existing hbox-apps deployment's /DATA
  --immich-db-password P  Existing Immich DB password (migration; default immich)
  --nextcloud-db-password P  Existing Nextcloud DB password (migration; default nextcloud)
  --tailscale-authkey KEY Enable Tailscale remote access with this key
  --no-mdns               Do not announce hbox.local, photos.local, ... on the LAN
  --yes                   Do not ask for confirmation
EOF
}

setup_env() {
    local data_root=$1 tz=$2 migrate=$3 immich_pw=$4 nextcloud_pw=$5
    if [ ! -f "$HBOX_ENV_FILE" ]; then
        log "Creating the HBOX configuration ($HBOX_ENV_FILE)"
        install -m 600 "$HBOX_HOME/.env.example" "$HBOX_ENV_FILE"
    fi
    env_set HBOX_HOME "$HBOX_HOME"
    [ -n "$data_root" ] && env_set DATA_ROOT "$data_root"
    [ -n "$tz" ] && env_set TZ "$tz"

    local key value
    for key in IMMICH_DB_PASSWORD NEXTCLOUD_DB_PASSWORD; do
        value=$(env_get_default "$key" '')
        case $value in '' | replace-with-*)
            if [ "$migrate" = 1 ]; then
                [ "$key" = IMMICH_DB_PASSWORD ] && value=$immich_pw || value=$nextcloud_pw
            else
                value=$(random_secret)
            fi
            env_set "$key" "$value"
            ;;
        esac
    done
    env_set HBOX_STATUS_DIR "$HBOX_STATUS_DIR"
    # Where updates come from (set by the installer's --ref / HBOX_REPO).
    [ -n "${HBOX_REPO:-}" ] && env_set HBOX_REPO "$HBOX_REPO"
    [ -n "${HBOX_REF:-}" ] && env_set HBOX_REF "$HBOX_REF"
    chmod 600 "$HBOX_ENV_FILE"
}

setup_dirs() {
    local data puid pgid
    data=$(env_get_default DATA_ROOT /DATA)
    puid=$(env_get_default PUID 1000)
    pgid=$(env_get_default PGID 1000)
    case $data in /*) ;; *) die "DATA_ROOT must be an absolute path." ;; esac

    log "Preparing data directories under $data"
    install -d -m 755 "$data" "$data/immich" "$data/nextcloud"
    install -d -m 750 "$data/immich/upload" "$data/immich/model-cache" "$data/dockge"
    # Immich mounts PGDATA itself (the image chowns it to postgres, mode 700).
    # PostgreSQL 18 mounts the parent and keeps PGDATA in 18/docker, so the
    # mount point must stay traversable; the data directory inside is 700.
    install -d -m 700 "$data/immich/pgdata" "$data/tailscale"
    install -d -m 755 "$data/nextcloud/pgdata"
    # Correct the mount point only (not its contents) on re-runs and migrations.
    chmod 755 "$data/nextcloud/pgdata"
    # Only set ownership on directories HBOX creates, never recursively on data.
    local dir
    for dir in "$data/nextcloud/config" "$data/nextcloud/data"; do
        if [ ! -d "$dir" ]; then
            install -d -m 750 -o "$puid" -g "$pgid" "$dir"
        fi
    done
    # HBOX_STATE holds backup status; only the dashboard subfolder is public.
    install -d -m 711 "$HBOX_STATE"
    install -d -m 700 "$HBOX_ETC"
    install -d -m 755 "$HBOX_STATUS_DIR"
    cmd_status_update
}

# Tailscale address and tailnet name, when HBOX's Tailscale is connected, or a
# previous deployment's Tailscale container that migration left running.
tailscale_identity() {
    local container=hbox-tailscale json
    if ! container_running "$container"; then
        container=$(old_tailscale_containers | head -n 1)
        [ -n "$container" ] || return 0
    fi
    json=$(docker exec "$container" tailscale status --json 2>/dev/null) || return 0
    printf '%s' "$json" | jq -r '.Self | ((.TailscaleIPs // [])[] | select(test(":") | not)), ((.DNSName // "") | rtrimstr(".") | select(length > 0)), ((.HostName // "") | ascii_downcase | select(length > 0))' 2>/dev/null
    return 0
}

# Every name and address HBOX should present a valid certificate for, beyond
# the fixed *.local names: LAN IP, <host>.local, Tailscale, user additions.
cert_names() {
    {
        primary_ip || true
        printf '%s.local\n' "$(hostname -s)"
        hostname -s
        tailscale_identity
        env_get_default HBOX_EXTRA_NAMES '' | tr ',' '\n'
    } | sed '/^$/d' | sort -u | paste -sd, -
}

# True when the certificate covers every current name and address.
cert_covers_names() {
    local cert=$HBOX_HOME/certs/selfsigned.crt name
    [ -f "$cert" ] || return 1
    for name in $(cert_names | tr ',' ' '); do
        openssl x509 -noout -checkhost "$name" -in "$cert" 2>/dev/null | grep -q 'does match' && continue
        openssl x509 -noout -checkip "$name" -in "$cert" 2>/dev/null | grep -q 'does match' && continue
        return 1
    done
}

issue_certificate() {
    HBOX_CERT_NAMES=$(cert_names) sh "$HBOX_HOME/scripts/generate-certs.sh" \
        "$HBOX_HOME/certs" "$HBOX_CA_DIR" >/dev/null
}

setup_certs() {
    if [ -f "$HBOX_HOME/certs/selfsigned.crt" ] && [ -f "$HBOX_HOME/certs/selfsigned.key" ]; then
        cert_covers_names || renew_certificate
        return 0
    fi
    log "Creating the HBOX certificate authority and HTTPS certificate"
    issue_certificate
}

# Registries rate-limit and networks drop; retry with backoff before failing.
with_retries() {
    local label=$1 attempt delay=10
    shift
    for attempt in 1 2 3 4 5; do
        "$@" && return 0
        [ "$attempt" -eq 5 ] && break
        warn "$label failed (attempt $attempt of 5); retrying in ${delay}s"
        sleep "$delay"
        delay=$((delay * 2))
    done
    die "$label failed after 5 attempts. Check the network connection and re-run the installer; finished steps are kept."
}

setup_images() {
    local stack
    log "Downloading app images (this can take several minutes)"
    for stack in hbox-core hbox-photos hbox-files hbox-dockge; do
        # One image at a time is slower but avoids registry rate limits.
        with_retries "Downloading $stack images" stack_compose "$stack" pull --quiet --policy missing
    done
    while IFS= read -r stack; do
        app_dir "$stack" >/dev/null || continue
        with_retries "Downloading app $stack" app_compose "$stack" pull --quiet --policy missing
    done < <(apps_enabled)
}

# Folders the nginx container mounts; they must exist before it starts.
ensure_runtime_dirs() {
    install -d -m 711 "$HBOX_STATE"
    install -d -m 755 "$HBOX_STATUS_DIR" "$HBOX_NGINX_APPS_DIR"
    dashboard_dirs
}

setup_nextcloud() {
    local user=$1 password=$2
    log "Waiting for Files (Nextcloud) to start"
    wait_for_nextcloud 600 || die "Nextcloud did not start. Inspect it with: sudo hbox logs nextcloud"
    if ! nextcloud_installed; then
        log "Installing Files (Nextcloud) — this takes a minute"
        occ maintenance:install --no-interaction \
            --database=pgsql --database-host=nextcloud-db --database-name=nextcloud \
            --database-user=nextcloud --database-pass="$(env_get NEXTCLOUD_DB_PASSWORD)" \
            --admin-user="$user" --admin-pass="$password" --data-dir=/data >/dev/null
        occ background:cron >/dev/null
        occ config:system:set maintenance_window_start --type=integer --value=1 >/dev/null
        occ config:system:set default_phone_region --value="$(env_get_default HBOX_PHONE_REGION US)" >/dev/null || true
    fi
    configure_nextcloud_proxy
    # The LinuxServer image applies caching and file locking on its next start.
    stack_compose hbox-files restart nextcloud >/dev/null
    wait_for_nextcloud 300 || warn "Nextcloud is slow to restart; check: sudo hbox logs nextcloud"
}

setup_immich() {
    local email=$1 user=$2 password=$3 port body
    port=127.0.0.1:2283
    log "Waiting for Photos (Immich) to start"
    wait_until 600 "Immich" http_ok "http://$port/api/server/ping"
    if curl -fsS "http://$port/api/server/config" | grep -q '"isInitialized":true'; then
        return 0
    fi
    log "Creating the Photos administrator"
    body=$(printf '{"email":"%s","password":"%s","name":"%s"}' "$email" "$password" "$user")
    curl -fsS -o /dev/null -X POST -H 'Content-Type: application/json' \
        --data-binary @- "http://$port/api/auth/admin-sign-up" <<<"$body" ||
        die "Could not create the Immich administrator."
}

setup_dockge() {
    local user=$1 password=$2 status=0
    log "Waiting for HBOX Admin (Dockge) to start"
    wait_until 180 "Dockge" http_ok "http://127.0.0.1:5001/"
    # The script is passed with -e (Node cannot read a piped /dev/stdin under
    # docker exec); credentials travel in the environment, not on argv.
    docker exec -e DOCKGE_ADMIN_USER="$user" -e DOCKGE_ADMIN_PASSWORD="$password" \
        hbox-dockge node -e "$(cat "$HBOX_LIB_DIR/dockge-setup.cjs")" >/dev/null || status=$?
    case $status in
        0) log "HBOX Admin account created." ;;
        3) ;;
        *) die "Could not create the Dockge administrator." ;;
    esac
}

setup_systemd() {
    log "Installing HBOX system services"
    local unit target
    # A hand-made hbox-backup job from before HBOX keeps running until adopted.
    preserve_legacy_backup_units
    for unit in "$HBOX_HOME"/systemd/*.service "$HBOX_HOME"/systemd/*.timer "$HBOX_HOME"/systemd/*.path; do
        target=$HBOX_SYSTEMD_DIR/$(basename "$unit")
        sed "s#/opt/hbox#$HBOX_HOME#g" "$unit" > "$target"
        chmod 644 "$target"
    done
    systemctl daemon-reload
    if [ "$(env_get_default HBOX_MDNS 1)" = 1 ] && command -v avahi-publish >/dev/null 2>&1; then
        systemctl enable --now avahi-daemon >/dev/null 2>&1 || true
        disable_foreign_mdns_aliases
        systemctl enable hbox-mdns.service >/dev/null
        systemctl restart hbox-mdns.service
    else
        systemctl disable --now hbox-mdns.service >/dev/null 2>&1 || true
    fi
    systemctl enable --now hbox-maintenance.timer hbox-status.timer hbox-update.timer hbox-dashboard.path >/dev/null
    if backup_configured; then
        (backrest_sync) || warn "Backups (Backrest) could not start; see: sudo hbox doctor"
    fi
}

cmd_setup() {
    require_root
    local data_root='' tz='' admin_user=admin admin_email=admin@hbox.local
    local migrate=0 immich_pw=immich nextcloud_pw=nextcloud ts_key='' mdns=1
    while [ "$#" -gt 0 ]; do
        case $1 in
            --data-root) data_root=$2; shift 2 ;;
            --timezone) tz=$2; shift 2 ;;
            --admin-user) admin_user=$2; shift 2 ;;
            --admin-email) admin_email=$2; shift 2 ;;
            --migrate) migrate=1; shift ;;
            --immich-db-password) immich_pw=$2; shift 2 ;;
            --nextcloud-db-password) nextcloud_pw=$2; shift 2 ;;
            --tailscale-authkey) ts_key=$2; shift 2 ;;
            --no-mdns) mdns=0; shift ;;
            --yes | -y) export HBOX_ASSUME_YES=1; shift ;;
            -h | --help) setup_usage; return 0 ;;
            *) die "Unknown setup option: $1 (see: hbox setup --help)" ;;
        esac
    done
    [[ $admin_user =~ ^[A-Za-z][A-Za-z0-9_.-]{1,31}$ ]] ||
        die "The admin user name must start with a letter and use letters, digits, . _ or -."
    [ -z "$tz" ] && tz=$(timedatectl show -p Timezone --value 2>/dev/null || true)
    require_docker

    setup_env "$data_root" "$tz" "$migrate" "$immich_pw" "$nextcloud_pw"
    env_set HBOX_MDNS "$mdns"
    local data
    data=$(env_get_default DATA_ROOT /DATA)

    # A fresh install must never initialize new apps over someone's existing
    # databases. HBOX_STATE/setup-started marks data this installer created,
    # so an interrupted fresh install can simply be re-run.
    if [ "$migrate" = 0 ] && [ ! -f "$HBOX_STATE/setup-started" ] &&
        [ -n "$(ls -A "$data/immich/pgdata" "$data/nextcloud/pgdata" 2>/dev/null)" ]; then
        die "$data already contains app databases. To adopt an existing hbox-apps deployment, re-run with --migrate (see wiki/Migrating-from-hbox-apps.md). To restore a backup, see wiki/Restore.md."
    fi

    if [ "$migrate" = 1 ]; then
        local config_php=$data/nextcloud/config/www/nextcloud/config/config.php major
        if [ -f "$config_php" ]; then
            major=$(grep -oE "'version' => '[0-9]+" "$config_php" | grep -oE '[0-9]+$' || true)
            local image_major
            image_major=$(env_get_default NEXTCLOUD_IMAGE lscr.io/linuxserver/nextcloud:35.0.3)
            image_major=${image_major##*:}
            image_major=${image_major%%.*}
            if [[ $major =~ ^[0-9]+$ && $image_major =~ ^[0-9]+$ ]] && [ $((image_major - major)) -gt 1 ]; then
                die "Your Nextcloud data is version $major, but HBOX ships $image_major. Nextcloud upgrades one major version at a time: set NEXTCLOUD_IMAGE=lscr.io/linuxserver/nextcloud:<$((major + 1)).x.y> in $HBOX_ENV_FILE, run setup, then step up."
            fi
        fi
    fi

    setup_dirs
    [ "$migrate" = 0 ] && touch "$HBOX_STATE/setup-started"
    setup_certs
    link_stack_env
    ensure_network
    ensure_runtime_dirs
    apps_render_all
    # Download everything while the old deployment is still serving,
    # so a migration is only down for the switch-over itself.
    setup_images

    if [ "$migrate" = 1 ]; then
        local old ts
        mapfile -t old < <(conflicting_containers | awk '!seen[$0]++')
        if [ "${#old[@]}" -gt 0 ]; then
            warn "These containers from the previous deployment must be removed first: ${old[*]}"
            echo "Their data in $data is kept. Back it up before continuing (wiki/Migrating-from-hbox-apps.md)." >&2
            confirm "Stop and remove these old containers now?" || die "Migration cancelled."
            # Stop apps before their databases, as on a normal shutdown.
            for name in hbox-nginx hbox-homepage homepage immich-server immich-machine-learning nextcloud dockge; do
                printf '%s\n' "${old[@]}" | grep -Fxq "$name" && docker stop -t 60 "$name" >/dev/null
            done
            # Databases get time for a clean shutdown.
            docker stop -t 120 "${old[@]}" >/dev/null
            docker rm "${old[@]}" >/dev/null
        fi
        mapfile -t ts < <(old_tailscale_containers)
        if [ "${#ts[@]}" -gt 0 ]; then
            warn "The old Tailscale container (${ts[*]}) is left running so remote access keeps working."
            echo "Switch to HBOX's Tailscale later from the LAN: docker stop ${ts[*]} && sudo hbox enable tailscale" >&2
        fi
    fi

    local password
    if [ -f "$HBOX_CREDENTIALS" ]; then
        password=$(env_get ADMIN_PASSWORD "$HBOX_CREDENTIALS")
        admin_user=$(env_get_default ADMIN_USER "$admin_user" "$HBOX_CREDENTIALS")
        admin_email=$(env_get_default ADMIN_EMAIL "$admin_email" "$HBOX_CREDENTIALS")
    else
        password=$(generate_password)
        install -m 600 /dev/null "$HBOX_CREDENTIALS"
        env_set ADMIN_USER "$admin_user" "$HBOX_CREDENTIALS"
        env_set ADMIN_EMAIL "$admin_email" "$HBOX_CREDENTIALS"
        env_set ADMIN_PASSWORD "$password" "$HBOX_CREDENTIALS"
    fi
    # The dashboard's update button uses this login.
    dashboard_sync_login

    if [ -n "$ts_key" ]; then
        env_set TS_AUTHKEY "$ts_key"
        env_set HBOX_ENABLE_TAILSCALE 1
    fi

    hbox_start_all
    apps_start_enabled
    # Everything the existing patches change is already in place.
    mark_migrations_done
    # Installed from a copied checkout: link it to git for updates now, so
    # the first `hbox update` only shows real changes. Offline is fine.
    if ! hbox_is_git; then
        ( ensure_git_checkout ) >/dev/null 2>&1 ||
            warn "Could not reach $(env_get_default HBOX_REPO https://github.com/ishrakr/hbox.git) yet; 'sudo hbox update' connects later."
    fi
    if [ "$migrate" = 1 ]; then
        wait_for_nextcloud 600 && nextcloud_installed && configure_nextcloud_proxy
        stack_compose hbox-files restart nextcloud >/dev/null || true
        wait_for_nextcloud 300 || warn "Nextcloud is slow to restart; check: sudo hbox logs nextcloud"
    else
        setup_nextcloud "$admin_user" "$password"
        setup_immich "$admin_email" "$admin_user" "$password"
    fi
    setup_dockge "$admin_user" "$password"
    setup_systemd
    touch "$HBOX_STATE/installed"

    heading "HBOX is ready."
    print_addresses
    if [ "$migrate" = 0 ]; then
        cat >&2 <<EOF

Administrator login (Files and Admin use the user name; Photos the e-mail):
    user:     $admin_user
    e-mail:   $admin_email
    password: $password
Show it again with: sudo hbox credentials
EOF
    else
        cat >&2 <<EOF

Your existing Photos and Files accounts are unchanged.
HBOX Admin (https://admin.local) login: $admin_user / $password
Show it again with: sudo hbox credentials
EOF
    fi
    if ! backup_configured && [ -f "$HBOX_SYSTEMD_DIR/$LEGACY_BACKUP_UNIT.service" ]; then
        legacy_backup_hint
    elif ! backup_configured; then
        cat >&2 <<'EOF'

Next step: turn on backups. Attach a USB or second disk and run:
    sudo hbox backup disk
(or use a NAS or cloud bucket: see /opt/hbox/wiki/Backups.md)
EOF
    fi
}

print_addresses() {
    local ip ts_name ts_ip
    ip=$(primary_ip || true)
    ts_name=$(tailscale_identity | grep -E '\.ts\.net$' | head -n 1 || true)
    ts_ip=$(tailscale_identity | grep -E '^100\.' | head -n 1 || true)
    cat >&2 <<EOF
    Dashboard:  https://hbox.local
    Photos:     https://hbox.local:2443    (or https://photos.local)
    Files:      https://hbox.local:3443    (or https://files.local)
    Admin:      https://hbox.local:5443    (or https://admin.local)
EOF
    local name
    while IFS= read -r name; do
        app_dir "$name" >/dev/null || continue
        printf '    %-11s https://hbox.local:%s\n' "$(app_get "$name" name || echo "$name"):" "$(app_get "$name" port)" >&2
    done < <(apps_enabled)
    [ -n "$ip" ] && printf '    On the LAN by address:    https://%s  (same ports)\n' "$ip" >&2
    [ -n "$ts_name" ] && printf '    Through Tailscale:        https://%s  (same ports)\n' "$ts_name" >&2
    [ -n "$ts_ip" ] && printf '    Through Tailscale by IP:  https://%s  (same ports)\n' "$ts_ip" >&2
    printf '    Trust HBOX HTTPS on a device: http://%s/hbox-ca.crt\n' "${ip:-hbox.local}" >&2
}

# ---------------------------------------------------------------- commands

cmd_status() {
    require_docker
    require_env
    heading "Apps"
    local name state health
    printf '  %-26s %-10s %s\n' CONTAINER STATE HEALTH
    for name in hbox-nginx immich-server immich-machine-learning immich_redis \
        immich-postgres nextcloud nextcloud-db hbox-dockge hbox-tailscale; do
        if ! docker inspect "$name" >/dev/null 2>&1; then
            [ "$name" = hbox-tailscale ] && continue
            printf '  %-26s %-10s\n' "$name" missing
            continue
        fi
        state=$(docker inspect -f '{{.State.Status}}' "$name")
        health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}-{{end}}' "$name")
        printf '  %-26s %-10s %s\n' "$name" "$state" "$health"
    done
    heading "Addresses"
    print_addresses
    heading "Storage"
    df -h "$(env_get_default DATA_ROOT /DATA)" | sed 's/^/  /'
    heading "Backups"
    backup_status | sed 's/^/  /'
}

cmd_logs() {
    require_docker
    if [ "$#" -gt 0 ]; then
        docker logs --tail 200 -f "$1"
    else
        local stack args=()
        while IFS= read -r stack; do
            args+=("$stack")
        done < <(enabled_stacks)
        for stack in "${args[@]}"; do
            stack_compose "$stack" logs --tail 50 --no-log-prefix 2>/dev/null | sed "s/^/[$stack] /" || true
        done
        echo "(Follow one service with: sudo hbox logs <container>)" >&2
    fi
}


cmd_doctor() {
    local problems=0 data
    check() {
        if eval "$2" >/dev/null 2>&1; then
            printf '  %sok%s    %s\n' "$C_GREEN" "$C_RESET" "$1"
        else
            printf '  %sFAIL%s  %s — %s\n' "$C_RED" "$C_RESET" "$1" "$3"
            problems=$((problems + 1))
        fi
    }
    data=$(env_get_default DATA_ROOT /DATA)
    heading "HBOX doctor"
    check "configuration exists" "[ -f '$HBOX_ENV_FILE' ]" "run the installer"
    check "Docker is running" "docker info" "sudo systemctl start docker"
    check "data directory exists" "[ -d '$data' ]" "mount the data disk at $data"
    check "data disk has 10% free" "[ \$(df --output=pcent '$data' | tail -1 | tr -dc 0-9) -lt 90 ]" "free up space"
    check "HTTPS certificate valid for 30+ days" "openssl x509 -checkend 2592000 -noout -in '$HBOX_HOME/certs/selfsigned.crt'" "sudo hbox certs renew"
    for c in hbox-nginx immich-server immich-postgres nextcloud nextcloud-db hbox-dockge; do
        check "$c is running" "container_running $c" "sudo hbox start; sudo hbox logs $c"
    done
    # Apps answer a little after their containers start; allow a minute.
    check "dashboard answers through nginx" "eventually curl -fsk -m 5 --resolve hbox.local:443:127.0.0.1 https://hbox.local/ -o /dev/null" "sudo hbox logs hbox-nginx"
    check "Photos answers" "eventually curl -fsS -m 5 http://127.0.0.1:2283/api/server/ping" "sudo hbox logs immich-server"
    check "Files answers" "eventually curl -fsk -m 5 https://127.0.0.1:3443/status.php -o /dev/null" "sudo hbox logs nextcloud"
    local app
    while IFS= read -r app; do
        app_dir "$app" >/dev/null || continue
        check "app $app answers" "eventually curl -sk -m 5 -o /dev/null https://127.0.0.1:$(app_get "$app" port)/" "sudo hbox apps disable $app; sudo hbox apps enable $app"
    done < <(apps_enabled)
    if [ "$(env_get_default HBOX_MDNS 1)" = 1 ]; then
        check "LAN names are announced (mDNS)" "systemctl is-active hbox-mdns" "sudo systemctl restart hbox-mdns"
    fi
    check "backups configured" "backup_configured" "attach a disk and run: sudo hbox backup disk"
    if backup_configured; then
        check "backup disk connected" "backup_disk_ready" "plug in the backup disk"
        check "last backup succeeded" "[ \"\$(env_get result '$HBOX_BACKUP_STATUS')\" = success ]" "sudo hbox backup run"
        check "Backups (Backrest) running" "systemctl is-active hbox-backrest && backrest_answers" "sudo hbox backup backrest-sync; journalctl -u hbox-backrest"
    fi
    echo
    [ "$problems" -eq 0 ] && log "No problems found." || die "$problems problem(s) found."
}

renew_certificate() {
    local ts dir=$HBOX_HOME/certs
    ts=$(date +%Y%m%d%H%M%S)
    if [ -f "$dir/selfsigned.crt" ]; then
        mv -- "$dir/selfsigned.crt" "$dir/selfsigned.crt.old-$ts"
        mv -- "$dir/selfsigned.key" "$dir/selfsigned.key.old-$ts"
    fi
    if ! issue_certificate; then
        # Put the previous certificate back rather than leave nginx without one.
        mv -- "$dir/selfsigned.crt.old-$ts" "$dir/selfsigned.crt" 2>/dev/null || true
        mv -- "$dir/selfsigned.key.old-$ts" "$dir/selfsigned.key" 2>/dev/null || true
        die "Could not issue a new certificate."
    fi
    rm -f -- "$dir"/selfsigned.*.old-*
    if container_running hbox-nginx; then
        docker exec hbox-nginx nginx -s reload >/dev/null 2>&1 || stack_compose hbox-core restart hbox-nginx
    fi
    log "Issued an HTTPS certificate for: hbox.local, photos.local, files.local, admin.local, $(cert_names | sed 's/,/, /g')"
}

cmd_certs() {
    require_root
    case ${1:-} in
        renew) renew_certificate ;;
        names) cert_names | tr ',' '\n' ;;
        *) die "Usage: hbox certs renew | hbox certs names" ;;
    esac
}

cmd_ca() {
    local ip
    ip=$(primary_ip || true)
    cat <<EOF
HBOX uses its own certificate authority for HTTPS. Trust it once per device:

  1. On the device, open  http://hbox.local/hbox-ca.crt ${ip:+ (or http://$ip/hbox-ca.crt)}
  2. Install it as a trusted certificate authority:
       Windows: open the file > Install Certificate > Local Machine >
                "Trusted Root Certification Authorities"
       macOS:   open it in Keychain Access, then set "Always Trust"
       iPhone:  install the profile, then Settings > General > About >
                Certificate Trust Settings > enable HBOX
       Android: Settings > Security > Encryption & credentials >
                Install a certificate > CA certificate

The certificate file on this server: $HBOX_HOME/certs/hbox-ca.crt
EOF
}

# Write the disk and backup facts the dashboard shows. Contains no secrets:
# sizes, times and the backup result only (never the repository location).
HBOX_STATUS_DIR=${HBOX_STATUS_DIR:-$HBOX_STATE/dashboard}
HBOX_USAGE_STATE=$HBOX_STATE/usage.json

# CPU and network use since the previous sample (about a minute: the status
# timer), keeping the last hour for the dashboard's charts. Network counts the
# physical interfaces only, not Docker's bridges, so traffic between the apps
# and nginx is not counted twice.
usage_sample() {
    local now total idle rx=0 tx=0 iface previous='{}'
    now=$(date +%s)
    read -r total idle < <(awk '/^cpu / {t = 0; for (i = 2; i <= 9; i++) t += $i; print t, $5 + $6}' /proc/stat)
    for iface in /sys/class/net/*; do
        [ -e "$iface/device" ] || continue
        rx=$((rx + $(cat "$iface/statistics/rx_bytes" 2>/dev/null || echo 0)))
        tx=$((tx + $(cat "$iface/statistics/tx_bytes" 2>/dev/null || echo 0)))
    done
    [ -s "$HBOX_USAGE_STATE" ] && previous=$(cat "$HBOX_USAGE_STATE")
    jq -n --argjson p "$previous" --argjson now "$now" --argjson total "${total:-0}" \
        --argjson idle "${idle:-0}" --argjson rx "$rx" --argjson tx "$tx" '
        ($p.time // 0) as $then | ($now - $then) as $dt
        # Runs seconds apart (e.g. after an update) would give noisy values.
        | if $then > 0 and $dt >= 0 and $dt < 20 then $p
          else
            (if $then > 0 and $dt <= 600 and $total > ($p.cpu_total // 0)
                and $rx >= ($p.rx // 0) and $tx >= ($p.tx // 0)
             then {t: $now,
                   cpu: ((1 - ($idle - $p.cpu_idle) / ($total - $p.cpu_total)) * 1000 | round / 10
                         | if . < 0 then 0 elif . > 100 then 100 else . end),
                   rx: (($rx - $p.rx) / $dt | round), tx: (($tx - $p.tx) / $dt | round)}
             else null end) as $sample
            | {time: $now, cpu_total: $total, cpu_idle: $idle, rx: $rx, tx: $tx,
               history: ((($p.history // []) + (if $sample then [$sample] else [] end))
                         | map(select(.t > $now - 3600)) | .[-60:])}
          end'
}

cmd_status_update() {
    local data total=0 used=0 configured=false result='' time='' next='' tmp
    local latest='' checked='' behind=0 summary='{}' disk=true
    data=$(env_get_default DATA_ROOT /DATA)
    install -d -m 755 "$HBOX_STATUS_DIR"
    if [ -d "$data" ]; then
        read -r total used < <(df -B1 --output=size,used "$data" | tail -n 1)
    fi
    if backup_configured; then
        configured=true
        if [ -f "$HBOX_BACKUP_STATUS" ]; then
            result=$(env_get result "$HBOX_BACKUP_STATUS" 2>/dev/null || true)
            time=$(env_get time "$HBOX_BACKUP_STATUS" 2>/dev/null || true)
        fi
        summary=$(backrest_summary 2>/dev/null) || summary='{}'
        next=$(jq -r '.next // ""' <<<"$summary")
        backup_disk_ready || disk=false
    fi
    if [ -f "$HBOX_UPDATE_STATE" ]; then
        latest=$(env_get latest "$HBOX_UPDATE_STATE" 2>/dev/null || true)
        checked=$(env_get checked "$HBOX_UPDATE_STATE" 2>/dev/null || true)
        behind=$(env_get_default behind 0 "$HBOX_UPDATE_STATE")
        [[ $behind =~ ^[0-9]+$ ]] || behind=0
    fi
    local usage='' load='' cpus
    if usage=$(usage_sample 2>/dev/null) && [ -n "$usage" ]; then
        printf '%s\n' "$usage" > "$HBOX_USAGE_STATE.tmp" && mv -f "$HBOX_USAGE_STATE.tmp" "$HBOX_USAGE_STATE"
    else
        usage='{}'
    fi
    read -r load _ < /proc/loadavg || load=0
    cpus=$(nproc 2>/dev/null || echo 1)
    tmp=$(mktemp "$HBOX_STATUS_DIR/status.json.XXXXXX")
    jq -n \
        --argjson usage "$usage" --argjson load "${load:-0}" --argjson cpus "$cpus" \
        --argjson total "${total:-0}" --argjson used "${used:-0}" \
        --argjson configured "$configured" --arg result "$result" \
        --arg time "$time" --arg next "$next" --argjson summary "$summary" \
        --argjson disk_connected "$disk" \
        --arg version "$(hbox_revision)" --arg latest "$latest" --arg checked "$checked" \
        --argjson behind "$behind" \
        --arg updated "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{updated: $updated, disk: {total: $total, used: $used},
          system: {cpus: $cpus, load: $load,
                   history: [($usage.history // [])[] | {t, cpu, rx, tx}]},
          backup: ({configured: $configured, result: $result, time: $time, next: $next,
                    connected: $disk_connected} + ($summary | {snapshots, protected})),
          hbox: {version: $version, latest: $latest, checked: $checked,
                 update_available: ($behind > 0)}}' > "$tmp"
    chmod 644 "$tmp"
    mv -f "$tmp" "$HBOX_STATUS_DIR/status.json"
}

cmd_maintenance() {
    require_root
    if ! openssl x509 -checkend 2592000 -noout -in "$HBOX_HOME/certs/selfsigned.crt" >/dev/null 2>&1; then
        log "The HTTPS certificate expires within 30 days; renewing"
        renew_certificate
    elif ! cert_covers_names; then
        log "The server's addresses changed; issuing a matching certificate"
        renew_certificate
    fi
    if container_running nextcloud && nextcloud_installed; then
        configure_nextcloud_proxy
    fi
    # Backrest runs the weekly integrity check and prune itself.
    if backup_configured && ! backrest_enabled; then
        backup_check
    fi
}

cmd_tailscale() {
    require_root
    require_env
    local action=$1
    shift
    case $action in
        enable)
            while [ "$#" -gt 0 ]; do
                case $1 in
                    --authkey) env_set TS_AUTHKEY "$2"; shift 2 ;;
                    --routes) env_set TS_ROUTES "$2"; shift 2 ;;
                    *) die "Unknown option: $1" ;;
                esac
            done
            [ -e /dev/net/tun ] || die "/dev/net/tun is missing; Tailscale needs the tun kernel module."
            install -d -m 700 "$(env_get_default DATA_ROOT /DATA)/tailscale"
            env_set HBOX_ENABLE_TAILSCALE 1
            stack_up hbox-tailscale
            if [ -z "$(env_get_default TS_AUTHKEY '')" ]; then
                log "Finish sign-in by opening the link below:"
                docker exec hbox-tailscale tailscale up --hostname="$(env_get_default TS_HOSTNAME hbox)" --timeout=5m || true
            fi
            local deadline=$((SECONDS + 60))
            until [ -n "$(tailscale_identity)" ] || [ "$SECONDS" -ge "$deadline" ]; do sleep 3; done
            if [ -n "$(tailscale_identity)" ]; then
                cert_covers_names || renew_certificate
                container_running nextcloud && nextcloud_installed && configure_nextcloud_proxy
                heading "HBOX on your tailnet"
                print_addresses
            else
                warn "Tailscale is not connected yet. Once it is, run: sudo hbox certs renew"
            fi
            ;;
        disable)
            env_set HBOX_ENABLE_TAILSCALE 0
            stack_compose hbox-tailscale down
            log "Tailscale is off. Its identity is kept for re-enabling."
            ;;
    esac
}

cmd_backup() {
    local sub=${1:-status}
    [ "$#" -gt 0 ] && shift
    case $sub in
        setup) require_root; require_env; backup_setup "$@" ;;
        disk) cmd_backup_disk "$@" ;;
        run) require_root; require_env; backup_run ;;
        hook) require_env; backup_hook "$@" ;;
        backrest-run) cmd_backrest_run ;;
        backrest-sync) require_root; require_env; backrest_sync ;;
        status) backup_status ;;
        snapshots) require_root; require_backup; run_restic snapshots --tag hbox ;;
        check) require_root; backup_check ;;
        restore) require_root; require_env; backup_restore "$@" ;;
        password) require_root; require_backup; cat "$HBOX_RESTIC_PASSWORD_FILE" ;;
        restic) require_root; require_backup; run_restic "$@" ;;
        *) die "Unknown backup command: $sub (see: hbox help)" ;;
    esac
}

cmd_uninstall() {
    require_root
    case ${1:-} in
        --yes | -y) export HBOX_ASSUME_YES=1 ;;
        '') ;;
        *) die "Unknown option for uninstall: $1" ;;
    esac
    cat >&2 <<EOF
This stops HBOX and removes its system services and the 'hbox' command.
Your photos, files, databases ($(env_get_default DATA_ROOT /DATA)), configuration
($HBOX_HOME, $HBOX_ETC) and backups are NOT deleted.
EOF
    confirm "Uninstall HBOX?" || die "Cancelled."
    local stack
    for stack in hbox-dockge hbox-tailscale hbox-files hbox-photos hbox-core; do
        stack_compose "$stack" down 2>/dev/null || true
    done
    docker network rm "$HBOX_NETWORK" >/dev/null 2>&1 || true
    systemctl disable --now hbox-backrest.service hbox-maintenance.timer hbox-status.timer hbox-update.timer hbox-dashboard.path hbox-mdns.service >/dev/null 2>&1 || true
    local unit
    # Only HBOX's own units; a previous backup job kept by migration stays.
    for unit in "$HBOX_HOME"/systemd/*.service "$HBOX_HOME"/systemd/*.timer "$HBOX_HOME"/systemd/*.path; do
        rm -f -- "$HBOX_SYSTEMD_DIR/$(basename "$unit")"
    done
    systemctl daemon-reload
    rm -f /usr/local/bin/hbox "$HBOX_STATE/installed"
    log "HBOX was removed. Reinstall any time with the installer; your data is reused."
}

main() {
    HBOX_COMMAND=${1:-help}
    [ "$#" -gt 0 ] && shift
    case $HBOX_COMMAND in
        status) cmd_status ;;
        start) require_root; require_docker; require_env; hbox_start_all ;;
        stop) require_root; require_docker; hbox_stop_all ;;
        restart) require_root; require_docker; require_env; hbox_stop_all; hbox_start_all ;;
        logs) cmd_logs "$@" ;;
        credentials) require_root; cat "$HBOX_CREDENTIALS" ;;
        doctor) require_root; cmd_doctor ;;
        update) cmd_update "$@" ;;
        rollback) cmd_rollback "$@" ;;
        apps) cmd_apps "$@" ;;
        backup) cmd_backup "$@" ;;
        enable | disable)
            [ "${1:-}" = tailscale ] || die "Usage: hbox $HBOX_COMMAND tailscale"
            shift
            cmd_tailscale "$HBOX_COMMAND" "$@"
            ;;
        certs) cmd_certs "$@" ;;
        ca) cmd_ca ;;
        maintenance) cmd_maintenance ;;
        status-update) require_root; cmd_status_update ;;
        dashboard-actions) cmd_dashboard_actions ;;
        setup) cmd_setup "$@" ;;
        uninstall) cmd_uninstall "$@" ;;
        help | -h | --help) usage ;;
        version) printf 'HBOX %s (following %s)\n' "$(hbox_revision)" "$(update_ref)" ;;
        *) usage >&2; exit 1 ;;
    esac
}

main "$@"
